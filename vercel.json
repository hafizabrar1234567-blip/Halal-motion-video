{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/director/(.*)", "destination": "/api/director" },
    { "source": "/api/director", "destination": "/api/director" },
    { "source": "/api/brand-settings", "destination": "/api/brand-settings" },
    { "source": "/api/render", "destination": "/api/render" },
    { "source": "/api/stills", "destination": "/api/stills" },
    { "source": "/api/upload/(.*)", "destination": "/api/upload" },
    { "source": "/api/upload", "destination": "/api/upload" },
    { "source": "/api/reveal", "destination": "/api/reveal" },
    { "source": "/api/ai/(.*)", "destination": "/api/ai" },
    { "source": "/api/ai", "destination": "/api/ai" }
  ]
}
